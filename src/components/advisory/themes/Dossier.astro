---
import type { AdvisoryLayoutProps } from '../layout-props.ts';
import { messages } from '../../../i18n/messages.ts';
import { advisorySummary } from '../../../advisories/generate.ts';
import Evidence from '../Evidence.astro';
import ScoreDetails from '../ScoreDetails.astro';
import ThemeNav from './ThemeNav.astro';
import ShareActions from '../../ShareActions.astro';

const { advisory, locale, home, alternate, canonical, shareTitle } = Astro.props as AdvisoryLayoutProps;
const s = messages[locale];
---

<main id="archive-dossier" class="theme-shell archive-dossier">
  <ThemeNav {locale} {home} {alternate} iconSet={advisory.iconSet} design={advisory.design} />
  <article class="dossier-paper">
    <header><p class="theme-parody">{s.parody}</p><h1 class="advisory-title">{advisory.title}</h1><p class="subtitle advisory-summary">{advisorySummary(advisory, locale)}</p></header>
    <div class="dossier-columns">
      <section class="dossier-notes">
        <h2>{s.cause}</h2><p>{advisory.cause[locale]}</p>
        <h2>{s.affected}</h2><p>{advisory.affected[locale]}</p>
        <h2>{s.mitigation}</h2><p>{advisory.workaround[locale]}</p>
        <Evidence {advisory} evidence={advisory.evidence} {locale} />
      </section>
      <aside class="dossier-margin" aria-label={s.score}>
        <p class="marginnote"><b>{s.cve}</b><br /><code>{advisory.cve}</code></p>
        <p class="marginnote"><b>{s.score}</b><br />{advisory.severity.score.toFixed(1)} · {s.ratings[advisory.severity.rating]}</p>
        <ScoreDetails severity={advisory.severity} {locale} />
        <ShareActions {locale} url={canonical} title={shareTitle} design={advisory.design} iconSet={advisory.iconSet} buttonClass="dossier-action" />
      </aside>
    </div>
  </article>
</main>
