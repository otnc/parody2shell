---
import { advisorySummary } from '../../../advisories/generate.ts';
import { messages } from '../../../i18n/messages.ts';
import ShareActions from '../../ShareActions.astro';
import Evidence from '../Evidence.astro';
import ScoreDetails from '../ScoreDetails.astro';
import type { AdvisoryLayoutProps as Props } from '../layout-props.ts';
import ThemeNav from './ThemeNav.astro';

const { advisory, locale, home, alternate, canonical, shareTitle } = Astro.props;
const s = messages[locale];
const topics = [
  [s.affected, advisory.affected[locale]], [s.mitigation, advisory.workaround[locale]], [s.cause, advisory.cause[locale]],
];
---
<main class="theme-shell helpdesk" id="help-article">
  <ThemeNav iconSet={advisory.iconSet} {locale} {home} {alternate} design={advisory.design} />
  <header class="uk-card uk-card-primary uk-card-body help-hero">
    <span class="uk-label">{s.parody}</span>
    <h1 class="advisory-title">{advisory.title}</h1>
    <p class="advisory-summary">{advisorySummary(advisory, locale)}</p>
  </header>
  <div class="help-answers">
    {topics.map(([topic, answer], index) => (
      <details open={index === 0} class="uk-card uk-card-default">
        <summary>{topic}</summary><p>{answer}</p>
      </details>
    ))}
  </div>
  <Evidence {advisory} evidence={advisory.evidence} {locale} />
  <footer class="help-footer">
    <div><p>{s.cve} <code>{advisory.cve}</code></p><p>{s.score} {advisory.severity.score.toFixed(1)} · {s.ratings[advisory.severity.rating]}</p><ScoreDetails severity={advisory.severity} {locale} /></div>
    <ShareActions iconSet={advisory.iconSet} {locale} url={canonical} title={shareTitle} design={advisory.design} buttonClass="uk-button uk-button-default uk-button-small" />
  </footer>
</main>
