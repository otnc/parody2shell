---
import type { AdvisoryLayoutProps } from '../layout-props.ts';
import { messages } from '../../../i18n/messages.ts';
import { advisorySummary } from '../../../advisories/generate.ts';
import Evidence from '../Evidence.astro';
import ScoreDetails from '../ScoreDetails.astro';
import ThemeNav from './ThemeNav.astro';
import ShareActions from '../../ShareActions.astro';

const { advisory, locale, home, alternate, canonical, shareTitle } = Astro.props as AdvisoryLayoutProps;
const s = messages[locale];
const articles = [
  ['affected', locale === 'ja' ? 'どこに影響がありますか？' : 'What is affected?', advisory.affected[locale]],
  ['response', locale === 'ja' ? 'どう対処すればいいですか？' : 'What should I do?', advisory.workaround[locale]],
  ['reason', locale === 'ja' ? 'なぜ起きるのですか？' : 'Why does this happen?', advisory.cause[locale]],
];
---

<main id="knowledge-base" class="theme-shell knowledge-base">
  <ThemeNav {locale} {home} {alternate} iconSet={advisory.iconSet} design={advisory.design} />
  <header>
    <p class="knowledge-crumb">{s.parody} / {s.cve} / <code>{advisory.cve}</code></p>
    <h1 class="advisory-title">{advisory.title}</h1>
    <p class="advisory-summary">{advisorySummary(advisory, locale)}</p>
  </header>
  <div class="knowledge-layout">
    <nav class="knowledge-index" aria-label={s.contents}>
      <h2>{s.contents}</h2><ol>{articles.map(([id, title]) => <li><a href={'#' + id}>{title}</a></li>)}</ol>
      <p><b>{s.score}</b><br />{advisory.severity.score.toFixed(1)} · {s.ratings[advisory.severity.rating]}</p>
      <ScoreDetails severity={advisory.severity} {locale} />
    </nav>
    <article class="knowledge-questions" aria-label={s.summary}>
      {articles.map(([id, title, answer], index) => <details {id} open={index === 0}><summary>{title}</summary><p>{answer}</p></details>)}
      <Evidence {advisory} evidence={advisory.evidence} {locale} />
      <ShareActions {locale} url={canonical} title={shareTitle} design={advisory.design} iconSet={advisory.iconSet} buttonClass="knowledge-action" />
    </article>
  </div>
</main>
