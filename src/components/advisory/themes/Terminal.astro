---
import { advisorySummary } from '../../../advisories/generate.ts';
import { messages } from '../../../i18n/messages.ts';
import ShareActions from '../../ShareActions.astro';
import Evidence from '../Evidence.astro';
import ScoreDetails from '../ScoreDetails.astro';
import type { AdvisoryLayoutProps as Props } from '../layout-props.ts';
import ThemeNav from './ThemeNav.astro';

const { advisory, locale, home, alternate, canonical, shareTitle } = Astro.props;
const s = messages[locale];
---
<main class="theme-shell terminal terminal-report" id="terminal-transcript">
  <ThemeNav iconSet={advisory.iconSet} {locale} {home} {alternate} design={advisory.design} />
  <p class="theme-parody">[{s.parody}]</p>
  <h1 class="advisory-title">{advisory.title}</h1>
  <section class="terminal-card">
    <header>{s.summary}</header>
    <div><p class="advisory-summary"><samp>{advisorySummary(advisory, locale)}</samp></p>
      <dl class="terminal-fields">
        <dt>{s.cve}</dt><dd><code>{advisory.cve}</code></dd>
        <dt>{s.score}</dt><dd><samp>{advisory.severity.score.toFixed(1)} · {s.ratings[advisory.severity.rating]}</samp></dd>
        <dt>{s.affected}</dt><dd>{advisory.affected[locale]}</dd>
      </dl>
    </div>
  </section>
  <blockquote><h2>{s.cause}</h2><p>{advisory.cause[locale]}</p></blockquote>
  <section class="terminal-alert terminal-alert-primary"><h2>{s.mitigation}</h2><p>{advisory.workaround[locale]}</p></section>
  <Evidence {advisory} evidence={advisory.evidence} {locale} />
  <ScoreDetails severity={advisory.severity} {locale} />
  <ShareActions iconSet={advisory.iconSet} {locale} url={canonical} title={shareTitle} design={advisory.design} buttonClass="btn btn-default btn-ghost" />
</main>
