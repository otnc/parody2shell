{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", ".cloudflare/types/index.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
